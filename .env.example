# ─── Wallet / Auth Provider ───────────────────────────────────────────────────
DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id
# DYNAMIC_PUBLIC_KEY is not needed — Dynamic uses JWKS for JWT validation
JWKS_ENDPOINT=https://app.dynamicauth.com/api/v0/sdk/YOUR_ENVIRONMENT_ID/.well-known/jwks
DYNAMIC_API_TOKEN=your-dynamic-api-token

# ─── Database ─────────────────────────────────────────────────────────────────
# Use the Supabase Session Pooler URL (IPv4 compatible) — NOT the Direct Connection
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:[YOUR_PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── EVM RPC URLs ─────────────────────────────────────────────────────────────
RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_ETH_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ─── Solana RPC ───────────────────────────────────────────────────────────────
RPC_SOLANA_DEVNET=https://api.devnet.solana.com

# ─── Balance Indexer ──────────────────────────────────────────────────────────
ZERION_API_KEY=your-zerion-api-key

# ─── Swap Engine ──────────────────────────────────────────────────────────────
LIFI_API_KEY=your-lifi-api-key   # optional for testnet; required for prod rate limits

# ─── Redis (for BullMQ job queue — needed from Step 7) ───────────────────────
REDIS_URL=redis://localhost:6379

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=your-sentry-dsn

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001

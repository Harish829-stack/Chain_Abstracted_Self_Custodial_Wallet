# ─── Wallet / Auth Provider ───────────────────────────────────────────────────
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_PUBLIC_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/caw

# ─── EVM RPC URLs ─────────────────────────────────────────────────────────────
RPC_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_ETH_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ─── Solana RPC ───────────────────────────────────────────────────────────────
RPC_SOLANA_DEVNET=https://api.devnet.solana.com

# ─── Balance Indexer ──────────────────────────────────────────────────────────
ZERION_API_KEY=

# ─── Swap Engine ──────────────────────────────────────────────────────────────
LIFI_API_KEY=                  # optional for testnet; required for prod rate limits

# ─── Redis (for BullMQ job queue — needed from Step 7) ───────────────────────
REDIS_URL=redis://localhost:6379

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
